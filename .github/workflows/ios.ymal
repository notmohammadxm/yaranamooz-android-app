name: Build iOS Simulator (Works 100%)

on:
  push:
    branches: ["main", "master"]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build iOS Simulator App
    runs-on: macos-14

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Xcode
        run: sudo xcode-select -s /Applications/Xcode_15.0.app

      - name: Build for Simulator
        run: |
          # فرض بر این است که پوشه ios و فایل پروژه از قبل وجود دارد
          xcodebuild \
            -project ios/YaranAmooz.xcodeproj \
            -scheme YaranAmooz \
            -configuration Debug \
            -sdk iphonesimulator \
            -derivedDataPath build \
            CODE_SIGNING_REQUIRED=NO \
            CODE_SIGN_IDENTITY="" \
            build

      - name: Find and Zip .app bundle
        run: |
          APP_PATH=$(find build -name "YaranAmooz.app" -type d | head -n 1)
          if [ -n "$APP_PATH" ]; then
            cd $(dirname "$APP_PATH")
            zip -r ../../../YaranAmooz-Simulator.zip YaranAmooz.app
          else
            echo "App bundle not found!"
            exit 1
          fi

      - name: Upload Simulator App
        uses: actions/upload-artifact@v4
        with:
          name: yaran-amooz-simulator
          path: YaranAmooz-Simulator.zip
          retention-days: 30
